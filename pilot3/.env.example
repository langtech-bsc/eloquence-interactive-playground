# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# OpenAI-compatible LLM endpoint. With the BSC setup this is the NEAR end of the SSH
# tunnel, which runs on the Mac host (ssh -N -L 9001:127.0.0.1:<VLLM_PORT> <user>@<bsc_vm>).
# Because the server runs in a bridge-networked container, it reaches the host-side tunnel
# via host.docker.internal (NOT localhost, which would be the container itself). The port
# must match the tunnel's local port.
# Public users without BSC access: point this at your own OpenAI-compatible endpoint.
LLM_API_BASE=http://host.docker.internal:9001/v1

# Leave blank if the endpoint is keyless (vLLM on the BSC VM is). Otherwise the token
# sent as "Authorization: Bearer <key>".
LLM_API_KEY=

# Exact model names the endpoint expects.
PILOT3_SALAMANDRA_MODEL=salamandra-7b-instruct
PILOT3_KRIKRI_MODEL=Llama-Krikri-8B-Instruct

# HuggingFace cache for LaBSE + ChromaDB downloads (use a local path, not Lustre).
HF_CACHE_DIR=/tmp/hf_cache
